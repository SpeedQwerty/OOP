<Window x:Class="MediaCatalog.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки — Lab 5 (Архивация)" Height="520" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Обработка данных (вариант 2 — архивация)" FontWeight="SemiBold" FontSize="14"/>

        <CheckBox x:Name="PipelineEnabledCheck" Grid.Row="1" Margin="0,10,0,6"
                  Content="Архивировать каталог перед сохранением и распаковывать после загрузки"/>

        <StackPanel Grid.Row="2" Margin="0,4,0,8">
            <TextBlock Text="Активный плагин архивации:" FontWeight="SemiBold"/>
            <ComboBox x:Name="PipelineCombo" Margin="0,4,0,0" DisplayMemberPath="DisplayName"
                      SelectionChanged="PipelineCombo_OnSelectionChanged"/>
        </StackPanel>

        <GroupBox Grid.Row="3" Header="Параметры выбранного плагина" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="SettingsPanel"/>
            </ScrollViewer>
        </GroupBox>

        <GroupBox Grid.Row="4" Header="Плагины" Margin="0,8,0,0" Padding="8">
            <StackPanel>
                <TextBlock x:Name="PluginsFolderText" TextWrapping="Wrap" FontSize="11" Foreground="#555"/>
                <ListBox x:Name="LoadedPluginsList" Height="70" Margin="0,6,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Загрузить DLL…" Click="LoadPluginClick" Padding="12,4" Margin="0,0,8,0"/>
                    <Button Content="Обновить из папки Plugins" Click="ReloadFolderClick" Padding="12,4"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Сохранить" Click="SaveClick" Padding="16,6" Margin="0,0,8,0" IsDefault="True"/>
            <Button Content="Отмена" Click="CancelClick" Padding="16,6" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
