<Window x:Class="MediaCatalog.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:MediaCatalog.Models"
        xmlns:vm="clr-namespace:MediaCatalog.ViewModels"
        Title="Каталог медиа — Lab5 (Архивация)" Height="600" Width="860"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <DataTemplate DataType="{x:Type models:Book}">
            <StackPanel>
                <TextBlock Text="Автор" FontWeight="SemiBold"/>
                <TextBox Text="{Binding Author, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                <TextBlock Text="Страниц" FontWeight="SemiBold"/>
                <TextBox Text="{Binding PageCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                <TextBlock Text="ISBN" FontWeight="SemiBold"/>
                <TextBox Text="{Binding ISBN, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type models:Magazine}">
            <StackPanel>
                <TextBlock Text="Номер выпуска" FontWeight="SemiBold"/>
                <TextBox Text="{Binding IssueNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                <TextBlock Text="Тема" FontWeight="SemiBold"/>
                <TextBox Text="{Binding Theme, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                <TextBlock Text="Периодичность (мес.)" FontWeight="SemiBold"/>
                <TextBox Text="{Binding PeriodicityMonths, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type models:EBook}">
            <StackPanel>
                <TextBlock Text="Автор" FontWeight="SemiBold"/>
                <TextBox Text="{Binding Author, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                <TextBlock Text="Формат" FontWeight="SemiBold"/>
                <TextBox Text="{Binding Format, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                <TextBlock Text="Размер (байт)" FontWeight="SemiBold"/>
                <TextBox Text="{Binding FileSizeBytes, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type models:Movie}">
            <StackPanel>
                <TextBlock Text="Режиссёр" FontWeight="SemiBold"/>
                <TextBox Text="{Binding Director, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                <TextBlock Text="Длительность (мин)" FontWeight="SemiBold"/>
                <TextBox Text="{Binding DurationMinutes, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                <TextBlock Text="Жанр" FontWeight="SemiBold"/>
                <TextBox Text="{Binding Genre, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type models:MusicAlbum}">
            <StackPanel>
                <TextBlock Text="Исполнитель" FontWeight="SemiBold"/>
                <TextBox Text="{Binding Artist, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                <TextBlock Text="Кол-во треков" FontWeight="SemiBold"/>
                <TextBox Text="{Binding TrackCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                <TextBlock Text="Жанр" FontWeight="SemiBold"/>
                <TextBox Text="{Binding Genre, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type models:Audiobook}">
            <StackPanel>
                <TextBlock Text="Автор" FontWeight="SemiBold"/>
                <TextBox Text="{Binding Author, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                <TextBlock Text="Чтец" FontWeight="SemiBold"/>
                <TextBox Text="{Binding Narrator, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                <TextBlock Text="Длительность (мин)" FontWeight="SemiBold"/>
                <TextBox Text="{Binding DurationMinutes, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Настройки">
                <MenuItem Header="Плагины и архивация…" Command="{Binding OpenSettingsCommand}"/>
            </MenuItem>
            <MenuItem Header="Справка">
                <MenuItem Header="О загруженных плагинах" Command="{Binding ShowPluginsInfoCommand}"/>
            </MenuItem>
        </Menu>
        <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="200"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Добавить" Command="{Binding AddCommand}" Padding="14,6" Margin="0,0,8,0"/>
            <Button Content="Удалить" Command="{Binding RemoveCommand}" Padding="14,6" Margin="0,0,8,0"/>
            <Button Content="Сохранить" Command="{Binding SaveCommand}" Padding="14,6" Margin="0,0,8,0"/>
            <Button Content="Загрузить" Command="{Binding LoadCommand}" Padding="14,6" Margin="0,0,8,0"/>
            <Button Content="Настройки" Command="{Binding OpenSettingsCommand}" Padding="14,6"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="Список объектов" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
        <TextBlock Grid.Row="1" Grid.Column="2" Text="Редактирование" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>

        <ListView Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Margin="0,0,0,8">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Категория" DisplayMemberBinding="{Binding TypeName}" Width="140"/>
                    <GridViewColumn Header="Название" DisplayMemberBinding="{Binding Title}" Width="280"/>
                    <GridViewColumn Header="Год" DisplayMemberBinding="{Binding Year}" Width="70"/>
                </GridView>
            </ListView.View>
        </ListView>

        <Border Grid.Row="2" Grid.Column="2" BorderBrush="#CCCCCC" BorderThickness="1" Padding="10" Background="#F8F8F8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Общие свойства" FontWeight="SemiBold" Foreground="#444"/>
                    <TextBlock Text="Название" FontSize="11"/>
                    <TextBox Text="{Binding SelectedItem.Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                    <TextBlock Text="Год" FontSize="11"/>
                    <TextBox Text="{Binding SelectedItem.Year, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                    <TextBlock Text="Издатель" FontSize="11"/>
                    <TextBox Text="{Binding SelectedItem.Publisher, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,12"/>
                    <TextBlock Text="Специфичные свойства" FontWeight="SemiBold" Foreground="#444"/>
                    <ContentControl Content="{Binding SelectedItem}" Margin="0,6,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Text="{Binding Status}" Foreground="Gray" FontSize="12"/>
        </Grid>
    </DockPanel>
</Window>
