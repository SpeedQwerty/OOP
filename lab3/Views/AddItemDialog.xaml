<Window x:Class="MediaCatalog.Views.AddItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить объект" Height="320" Width="320"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Выберите тип объекта:" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <ListBox x:Name="TypeList" Grid.Row="1" DisplayMemberPath="TypeName"
                 SelectionMode="Single" Margin="0,0,0,12" FontSize="14"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Добавить" Width="90" Height="28" Margin="0,0,8,0" IsDefault="True" Click="OnOk"/>
            <Button Content="Отмена" Width="90" Height="28" IsCancel="True" Click="OnCancel"/>
        </StackPanel>
    </Grid>
</Window>
